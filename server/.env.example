# MongoDB Atlas connection string (required for Vercel + local API mode)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name (default: airtel_challenge)
MONGODB_DB_NAME=airtel_challenge

# Optional: map each hostname to its own MongoDB database (isolated user data per link).
# Comma-separated host=dbname pairs, or JSON object. www. prefix is ignored.
# AIRTEL_INSTANCE_MAP=campaign1.example.com=airtel_campaign1,campaign2.example.com=airtel_campaign2
# AIRTEL_INSTANCE_MAP={"campaign1.example.com":"airtel_campaign1","campaign2.example.com":"airtel_campaign2"}

# API port for local `npm run api` only (ignored on Vercel)
PORT=3001

# Calendar day for daily limits & scores (India)
AIRTEL_DAY_TIMEZONE=Asia/Kolkata

# Admin dashboard key — set on Vercel as env var for production
ADMIN_KEY=change-me-to-a-long-random-string

# Whitelist disabled (registration is name + phone only)
PHONE_WHITELIST=off
