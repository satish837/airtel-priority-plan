# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Optional database name (default: airtel_challenge)
MONGODB_DB_NAME=airtel_challenge

# API port (default: 3001)
PORT=3001

# Calendar day for daily limits & score buckets (Node Intl). Use Asia/Kolkata for India.
AIRTEL_DAY_TIMEZONE=Asia/Kolkata

# Dashboard access key (optional locally; recommended in production)
ADMIN_KEY=change-me-to-a-long-random-string

# Whitelist source: auto (MongoDB if populated, else JSON files), mongodb, or file
PHONE_WHITELIST_SOURCE=auto
